<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>teacher's calling</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Pretendard:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Pretendard', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 min-h-screen flex flex-col justify-between text-slate-800">

    <header class="bg-indigo-600 text-white shadow-md py-6 px-4">
        <div class="max-w-xl mx-auto text-center">
            <h1 class="text-2xl md:text-3xl font-bold tracking-tight">🏫 teacher's calling</h1>
        </div>
    </header>

    <main class="max-w-xl w-full mx-auto p-4 md:p-6 my-auto">
        
        <div id="status-box" class="hidden mb-6 p-4 rounded-xl text-sm font-semibold text-center transition-all duration-300 shadow-sm"></div>

        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8">
            <h2 class="text-lg font-bold text-slate-700 mb-6 flex items-center gap-2">
                ✍️ 호출 정보
            </h2>
            <form id="custom-form" onsubmit="handleCustomSubmit(event)" class="space-y-5">
                <div>
                    <label class="block text-sm font-semibold text-slate-600 mb-1.5">호출 제목</label>
                    <input type="text" id="input-title" value="알림사항" placeholder="예: 알림사항" required
                        class="w-full px-4 py-3.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm font-medium">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-600 mb-1.5">호출 내용</label>
                    <textarea id="input-text" rows="3" placeholder="대시보드에 띄울 내용을 입력하세요" required
                        class="w-full px-4 py-3.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"></textarea>
                </div>
                <button type="submit" id="submit-btn"
                    class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-4 px-6 rounded-xl shadow-md transition transform active:scale-98 flex items-center justify-center gap-2 text-base mt-2">
                    <span>대시보드로 전송하기</span>
                </button>
            </form>
        </div>

    </main>

    <footer class="text-center py-6 text-xs text-slate-400">
        Teacher's Calling Dashboard &copy; 2026
    </footer>

    <script>
        // 앱스스크립트 웹앱 URL
        const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbx4mkHOlwxTIMQ4hjp7tnrxh-58xKEYeBvAwTvCNCkvpb8uo_o3_e-i2rV2q7ROIjD8/exec";

        // 상태 메시지 표시 함수
        function showStatus(message, isSuccess = true) {
            const statusBox = document.getElementById('status-box');
            statusBox.textContent = message;
            statusBox.className = `mb-6 p-4 rounded-xl text-sm font-semibold text-center transition-all duration-300 shadow-sm ${
                isSuccess ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-rose-50 text-rose-700 border border-rose-200'
            }`;
            statusBox.classList.remove('hidden');

            setTimeout(() => {
                statusBox.classList.add('hidden');
            }, 4000);
        }

        // 서버 전송 로직 (active는 항상 TRUE로 전송)
        async function sendCall(title, text) {
            const submitBtn = document.getElementById('submit-btn');
            if (submitBtn) submitBtn.disabled = true;

            showStatus("⏳ 대시보드로 호출을 전송 중입니다...", true);

            // 항상 active=true 고정 전송
            const active = true;
            const targetUrl = `${SCRIPT_URL}?active=${active}&title=${encodeURIComponent(title)}&text=${encodeURIComponent(text)}`;

            try {
                await fetch(targetUrl, {
                    method: 'GET',
                    mode: 'no-cors'
                });

                showStatus(`✅ 성공적으로 호출되었습니다! [${title} / ${text}]`, true);
            } catch (error) {
                console.error(error);
                showStatus("❌ 전송 중 오류가 발생했습니다. 네트워크 상태를 확인해주세요.", false);
            } finally {
                if (submitBtn) submitBtn.disabled = false;
            }
        }

        // 폼 제출 처리
        function handleCustomSubmit(event) {
            event.preventDefault();
            const title = document.getElementById('input-title').value.trim();
            const text = document.getElementById('input-text').value.trim();

            if (!title || !text) {
                showStatus("⚠️ 제목과 내용을 모두 입력해주세요.", false);
                return;
            }

            sendCall(title, text);
        }
    </script>
</body>
</html>
